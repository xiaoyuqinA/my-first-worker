# 复制为 .dev.vars 后填入真实值（.dev.vars 已被 .gitignore 忽略，切勿提交）
#
# 本地开发：npx wrangler dev 会自动读取 .dev.vars
# 生产环境：使用 `npx wrangler secret put <NAME>` 写入密钥，不要写进 wrangler.jsonc

# --- LLM / AI（OpenAI 兼容接口，可选；优先使用 Workers AI 绑定时无需配置）---
AI_API_KEY="your-api-key-here"
AI_BASE_URL="https://your-llm-endpoint.example.com/v1"
AI_MODEL="@cf/meta/llama-3.1-8b-instruct"

# --- 支付（示例，按需填写）---
PAYMENT_SECRET="your-payment-secret-here"
